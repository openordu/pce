{
  "name": "Cailleach",
  "attributes": [
    {
      "entity": "Cailleach",
      "attribute": "goddess and hag figure of Scotland and Ireland"
    },
    {
      "entity": "Cailleach",
      "attribute": "name means veiled one or hooded one"
    },
    {
      "entity": "Cailleach",
      "attribute": "derived from a pre-Celtic divinity"
    },
    {
      "entity": "Cailleach",
      "attribute": "one-eyed with a blue-grey complexion"
    },
    {
      "entity": "Cailleach",
      "attribute": "created mountains and islands from her apron and staff"
    },
    {
      "entity": "Cailleach",
      "attribute": "goddess of winter and storm weather"
    },
    {
      "entity": "Cailleach",
      "attribute": "granted sovereignty to a chosen king"
    },
    {
      "entity": "Hag of Beare",
      "attribute": "Munster name used for the Cailleach"
    },
    {
      "entity": "Cailleach",
      "attribute": "gives way to Bride at spring"
    },
    {
      "entity": "Cailleach Bhéirre",
      "attribute": "Irish name for the sovereignty figure, preferred over the English tags Nun, Hag, and Old Woman of Beare"
    },
    {
      "entity": "Cailleach",
      "attribute": "gives her name to the final sheaf of the harvest in Ireland and Gaelic Scotland"
    },
    {
      "entity": "Cailleach",
      "attribute": "Scottish farms tie her sheaf with a ribbon, keep it on a nail through winter, and give it to the horse at first ploughing"
    }
  ],
