  "attributes": [
    {
      "entity": "Samhain",
      "attribute": "the Celtic festival of November 1 that opened the new year"
    },
    {
      "entity": "Samhain",
      "attribute": "a night when the veil between worlds grew thin"
    },
    {
      "entity": "Samoni",
      "attribute": "the Gaulish month-name on the Coligny calendar"
    }
