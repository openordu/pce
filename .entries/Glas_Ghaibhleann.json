{
    "name": "Glas Ghaibhleann",
    "attributes": [
        {
            "entity": "Glas Ghaibhleann",
            "attribute": "is a cow of abundance in Irish myth"
        },
        {
            "entity": "Glas Ghaibhleann",
            "attribute": "produced plentiful milk and butter"
        },
        {
            "entity": "Glas Ghaibhleann",
            "attribute": "crossed three Irish provinces in one day"
        },
        {
            "entity": "Glas Ghaibhleann",
            "attribute": "gave milk freely to all who needed it"
        },
        {
            "entity": "Glas Ghaibhleann",
            "attribute": "is known as the Dun Cow in Britain and Wales"
        }
    ],
