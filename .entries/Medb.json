{
  "name": "Medb",
  "attributes": [
    {
      "entity": "Medb",
      "attribute": "an Irish goddess and heroine, also written Maeve, Medbh, Medhbh, and Meave"
    },
    {
      "entity": "Medb",
      "attribute": "queen of Connacht who ruled from the royal seat at Cruachan"
    },
    {
      "entity": "Medb",
      "attribute": "a goddess of the land whose marriage to the king granted sovereignty"
    },
    {
      "entity": "Medb",
      "attribute": "linked with the five fierce war figures the Badb, sometimes including the Mórrígan"
    },
    {
      "entity": "Medb",
      "attribute": "born in the cave Oweynagat of the obscure woman Crochan Crocderg"
    },
    {
      "entity": "Medb",
      "attribute": "her name means mead or intoxication"
    },
    {
      "entity": "Medb",
      "attribute": "her cattle raid on Ulster set her against the hero Cúchulainn"
    },
    {
      "entity": "Medb",
      "attribute": "killed by her nephew Furbaide Ferbend on the island of Clothrann"
    },
    {
      "entity": "Medb",
      "attribute": "as Medb Lethderg she married the kings of Tara, the goddess of sovereignty"
    }
  ],
